# Server
PORT=3333
ALLOWED_ORIGINS=http://localhost:3000

# YouTube Data API
YOUTUBE_API_KEY=

# Conversion limits
MAX_VIDEO_DURATION_MINUTES=20
MAX_CONCURRENT_CONVERSIONS=2
MAX_FILE_SIZE_MB=200

# Conversion queue
MAX_QUEUE_SIZE=10
JOB_EXPIRATION_MINUTES=60

# File cleanup
FILE_EXPIRATION_MINUTES=30
CLEANUP_INTERVAL_MINUTES=5

# Conversion rate limit
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=5

# Info rate limit
INFO_RATE_LIMIT_MAX=15
INFO_RATE_LIMIT_WINDOW_MINUTES=1

# Validate rate limit
VALIDATE_RATE_LIMIT_MAX=30
VALIDATE_RATE_LIMIT_WINDOW_MINUTES=1

# Status rate limit
STATUS_RATE_LIMIT_MAX=120
STATUS_RATE_LIMIT_WINDOW_MINUTES=1

# Download rate limit
DOWNLOAD_RATE_LIMIT_MAX=20
DOWNLOAD_RATE_LIMIT_WINDOW_MINUTES=5